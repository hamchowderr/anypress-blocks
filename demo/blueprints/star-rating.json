{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "AnyPress Blocks demo: Star rating",
		"author": "hamchowderr",
		"description": "The Star rating block from AnyPress Blocks, working on a page of the AnyPress theme, with the latest releases."
	},
	"landingPage": "/blocks/star-rating/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"steps": [
		{
			"step": "login"
		},
		{
			"step": "installTheme",
			"themeData": {
				"resource": "url",
				"url": "https://github.com/hamchowderr/anypress-theme/releases/latest/download/anypress.zip"
			},
			"options": {
				"activate": true,
				"targetFolderName": "anypress"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/hamchowderr/anypress-blocks/releases/latest/download/anypress-blocks.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "fluentform"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "writeFiles",
			"writeToPath": "/wordpress/wp-content/anypress-blocks-demo",
			"filesTree": {
				"resource": "git:directory",
				"url": "https://github.com/hamchowderr/anypress-blocks",
				"ref": "main",
				"refType": "branch",
				"path": "demo"
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require '/wordpress/wp-load.php'; require WP_CONTENT_DIR . '/anypress-blocks-demo/build.php';"
		}
	]
}
