{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "anypress/age-check",
	"version": "0.4.0",
	"title": "Age Check",
	"category": "design",
	"description": "Asks visitors to confirm their age before they see the site, for shops selling alcohol, tobacco or other age-restricted goods. Remembers the answer. Put it in the footer to cover every page.",
	"keywords": [
		"age",
		"age gate",
		"age verification",
		"21",
		"18",
		"alcohol"
	],
	"textdomain": "anypress-blocks",
	"attributes": {
		"minAge": {
			"type": "number",
			"default": 21
		},
		"yesLabel": {
			"type": "string",
			"default": ""
		},
		"noLabel": {
			"type": "string",
			"default": ""
		},
		"leaveUrl": {
			"type": "string",
			"default": ""
		},
		"rememberDays": {
			"type": "number",
			"default": 30
		}
	},
	"supports": {
		"html": false,
		"multiple": false,
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"spacing": {
			"padding": true,
			"blockGap": true
		},
		"__experimentalBorder": {
			"radius": true
		},
		"layout": {
			"default": {
				"type": "flow"
			},
			"allowSwitching": false,
			"allowInheriting": false
		},
		"interactivity": true
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor.css",
	"style": "file:./style.css",
	"viewScriptModule": "file:./view.js",
	"render": "file:./render.php"
}
